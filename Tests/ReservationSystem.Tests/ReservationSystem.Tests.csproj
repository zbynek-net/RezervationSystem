<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ReservationSystem.Tests</AssemblyName>
    <RootNamespace>ReservationSystem.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <!--
      The main web project targets .NET Framework 4.5.2. This test project targets net48 - a
      superset that runs on the same 4.x CLR - so xUnit's netstandard dependencies resolve cleanly
      without the net452 facade-reference issues, and so it uses the normally-installed v4.8
      targeting pack (no FrameworkPathOverride needed for this project).
    -->
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Also usable from the command line without VS: xunit.console.exe from this package. -->
    <PackageReference Include="xunit.runner.console" Version="2.4.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Required at compile time: FakeUnitOfWork exposes DbContextWrap, whose base type lives in EF. -->
    <PackageReference Include="EntityFramework" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\WebApplication3\ReservationSystem.csproj" />
  </ItemGroup>

</Project>
